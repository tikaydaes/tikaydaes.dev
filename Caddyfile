# Runs inside the container. The host's reverse proxy handles TLS.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	}

	@fonts path /fonts/*
	header @fonts Cache-Control "public, max-age=31536000, immutable"

	@assets path /img/* *.css *.png
	header @assets Cache-Control "public, max-age=3600"
}
